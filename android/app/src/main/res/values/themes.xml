<?xml version="1.0" encoding="utf-8"?>
<!-- The desktop window's look (src/ui.html): the dark page, its green glow, the green-to-teal button. -->
<resources>
    <color name="page">#0a0f1c</color>
    <color name="ink">#e8eefc</color>
    <color name="ink_2">#a6b3cc</color>
    <color name="muted">#6f7d99</color>
    <color name="line">#1fe8eefc</color>

    <style name="Theme.Importer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:colorAccent">#199e70</item>
    </style>

    <style name="Button" parent="android:Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:maxWidth">420dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Button.Primary">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Button.Secondary">
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/ink</item>
    </style>
</resources>
